  "fgw_aligned_hi": {
   "what": "fgw_aligned (try E10's aligned moves) with every cell at the deeper bracket's depth: a top-up-only file at the aligned positions",
   "mode": "hi",
   "rule": "depth render: every drawn cell of a bracket is moved by the bracket's ratio target / d, d = the bracket's median counts per cell over all its cells. The target is DEPTH_RULE's log-linear depth (mid), the shallower bracket's median (lo) or the deeper bracket's median (hi). A ratio below 1 thins the cell binomially, as DEPTH_RULE does. A ratio above 1 adds Poisson counts with mean (ratio - 1) x the cell's library size x the mean proportions of its 15 nearest cells of its own bracket (itself included; 30 principal components of the bracket's log1p panel expression), and adds Poisson((ratio - 1) x n) to its n counts outside the panel. A ratio of 1 leaves the rows as released",
   "alpha": 0.5,
   "scope": "whole",
   "tuned_on": [],
   "externals": []
  },
  "fgw_early_specialist": {
   "what": "fgw's draws and positions with the deeper bracket's cells thinned gene by gene to the shallower bracket's profile and depth (a Poisson top-up only where a gene's keep factor exceeds 1)",
   "rule": "early specialist: the deeper bracket's drawn cells are moved gene by gene to the shallower bracket's profile and depth: per gene the keep factor q = phi x d_shallow / d_deep, phi the T3 script's gene_factor from the deeper to the shallower bracket over SERIES_RULE's matched extraembryonic labels (weights the deeper bracket's label shares, eps 1e-5, rescaled, clipped to 0.25-4). Panel counts are binomially thinned by q where q < 1 and topped up by Poisson(q - 1 x the cell's panel counts x its 15-neighbour smoothed proportion) where q > 1 (vec.core.apply_gene_factor's two steps); the counts outside the panel are thinned by d_shallow / d_deep; a cell left without panel counts is drawn again (DEPTH_ZERO_RETRIES), and one still without panel counts after that keeps its released row (the empty-cell rule of vec.core.apply_gene_factor). The shallower bracket's cells stay as released",
   "scope": "whole",
   "tuned_on": [],
   "externals": []
  }
 },
